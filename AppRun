#!/usr/bin/env bash
# ==============================================================================
# Tabula AppImage Entrypoint
# ==============================================================================
set -e

# Resolve directory of AppImage mount point
HERE="$(dirname "$(readlink -f "${0}")")"

# 1. Dynamically locate the bundled Java binary
if [ -x "${HERE}/usr/lib/jvm/bin/java" ]; then
  JAVA_BIN="${HERE}/usr/lib/jvm/bin/java"
  JAVA_HOME="${HERE}/usr/lib/jvm"
else
  # Search within usr/lib/jvm in case of archive hierarchy variations
  JAVA_BIN=$(find "${HERE}/usr/lib/jvm" -type f -name "java" -perm -111 2>/dev/null | head -n 1)
  if [ -n "${JAVA_BIN}" ]; then
    JAVA_HOME="$(dirname "$(dirname "${JAVA_BIN}")")"
  elif command -v java >/dev/null 2>&1; then
    echo "[Tabula] Warning: Bundled JRE not found, falling back to system java." >&2
    JAVA_BIN="$(command -v java)"
    JAVA_HOME="$(dirname "$(dirname "$(readlink -f "${JAVA_BIN}")")")"
  else
    echo "[Tabula] Fatal Error: No Java runtime found." >&2
    exit 1
  fi
fi

export JAVA_HOME
export PATH="${JAVA_HOME}/bin:${PATH}"

# Preserve original environment for external processes (e.g. host web browser)
export ORIGINAL_LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"

# Locate Tabula JAR
TABULA_JAR="${HERE}/usr/share/tabula/tabula.jar"
if [ ! -f "${TABULA_JAR}" ]; then
  TABULA_JAR=$(find "${HERE}/usr/share/tabula" -type f -name "*.jar" 2>/dev/null | head -n 1)
fi

if [ ! -f "${TABULA_JAR}" ]; then
  echo "[Tabula] Fatal Error: tabula.jar not found inside AppImage." >&2
  exit 1
fi

# Configurable options
TABULA_PORT="${TABULA_PORT:-8080}"

# Check port availability
is_port_in_use() {
  local port="$1"
  # 1. Native Bash /dev/tcp test
  if (exec 3<>/dev/tcp/127.0.0.1/"${port}") 2>/dev/null; then
    exec 3>&-
    return 0
  fi
  # 2. Python fallback
  if command -v python3 >/dev/null 2>&1; then
    python3 -c "import socket; s = socket.socket(); s.connect(('127.0.0.1', ${port})); s.close()" 2>/dev/null && return 0
  fi
  return 1
}

# Auto-increment port if default 8080 is already occupied
PORT_SCAN_LIMIT=10
while is_port_in_use "${TABULA_PORT}"; do
  echo "[Tabula] Notice: Port ${TABULA_PORT} is in use."
  TABULA_PORT=$((TABULA_PORT + 1))
  PORT_SCAN_LIMIT=$((PORT_SCAN_LIMIT - 1))
  if [ "${PORT_SCAN_LIMIT}" -le 0 ]; then
    echo "[Tabula] Error: No free port found in range." >&2
    exit 1
  fi
done

echo "[Tabula] Launching Tabula server on http://127.0.0.1:${TABULA_PORT}/"

# Core JVM Flags
JVM_OPTS=(
  "-Dfile.encoding=utf-8"
  "-Xms256M"
  "-Xmx1024M"
  "-Dwarbler.port=${TABULA_PORT}"
)

# Parse runtime arguments
OPEN_BROWSER="true"
USER_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --no-browser|-n)
      OPEN_BROWSER="false"
      ;;
    *)
      USER_ARGS+=("$arg")
      ;;
  esac
done

if [ "${OPEN_BROWSER}" = "true" ]; then
  JVM_OPTS+=("-Dtabula.openBrowser=true")
else
  JVM_OPTS+=("-Dtabula.openBrowser=false")
fi

# Execute Tabula directly via exec to maintain clean signal propagation (SIGINT/SIGTERM)
exec "${JAVA_BIN}" "${JVM_OPTS[@]}" ${TABULA_JAVA_OPTS:-} -jar "${TABULA_JAR}" "${USER_ARGS[@]}"
