#!/usr/bin/env bash
# ==============================================================================
# Tabula AppImage Entrypoint
# Resilient Runtime Discovery, Fallback & Explicit Port Verification
# ==============================================================================
set -u

# Resolve AppImage mount directory
HERE="$(dirname "$(readlink -f "${0}")")"

# Preserve host LD_LIBRARY_PATH before we modify it
export ORIG_LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"

# ------------------------------------------------------------------------------
# 1. Locate Java Runtime (Bundled JRE with Host Fallback)
# ------------------------------------------------------------------------------
JAVA_BIN=""
JAVA_HOME=""

# Check primary bundled path
if [ -f "${HERE}/usr/lib/jvm/bin/java" ]; then
  JAVA_BIN="${HERE}/usr/lib/jvm/bin/java"
  JAVA_HOME="${HERE}/usr/lib/jvm"
else
  # Search recursively inside usr/lib/jvm in case of non-standard extraction
  DETECTED_BIN=$(find "${HERE}/usr/lib/jvm" -type f -name "java" -perm -111 2>/dev/null | head -n 1 || true)
  if [ -n "${DETECTED_BIN}" ]; then
    JAVA_BIN="${DETECTED_BIN}"
    JAVA_HOME="$(dirname "$(dirname "${JAVA_BIN}")")"
  fi
fi

# Pre-flight execution check: Verify that JAVA_BIN can actually execute on this host
CAN_EXEC_BUNDLED=false
if [ -n "${JAVA_BIN}" ] && [ -x "${JAVA_BIN}" ]; then
  if "${JAVA_BIN}" -version >/dev/null 2>&1; then
    CAN_EXEC_BUNDLED=true
  fi
fi

if [ "${CAN_EXEC_BUNDLED}" = "true" ]; then
  export JAVA_HOME
  export PATH="${JAVA_HOME}/bin:${PATH}"
else
  # Bundled JRE is missing or incompatible with host libc/kernel (e.g., NixOS/musl)
  if command -v java >/dev/null 2>&1 && java -version >/dev/null 2>&1; then
    echo "[Tabula] Notice: Bundled JRE is incompatible with host environment. Falling back to system Java."
    JAVA_BIN="$(command -v java)"
    JAVA_HOME="$(dirname "$(dirname "$(readlink -f "${JAVA_BIN}")")")"
    export JAVA_HOME
    export PATH="${JAVA_HOME}/bin:${PATH}"
  else
    echo "================================================================================" >&2
    echo "[Tabula] FATAL ERROR: Unable to execute Java." >&2
    echo "The bundled Java runtime could not be executed on this system." >&2
    if [ -n "${JAVA_BIN}" ]; then
      echo "Target binary : ${JAVA_BIN}" >&2
      if command -v file >/dev/null 2>&1; then
        echo "Binary info   : $(file "${JAVA_BIN}")" >&2
      fi
    fi
    echo "Host Kernel   : $(uname -srm 2>/dev/null || true)" >&2
    echo "Please ensure a working Java 8+ runtime is installed on your host system." >&2
    echo "================================================================================" >&2
    exit 1
  fi
fi

# ------------------------------------------------------------------------------
# 2. Locate Tabula JAR Package
# ------------------------------------------------------------------------------
TABULA_JAR="${HERE}/usr/share/tabula/tabula.jar"
if [ ! -f "${TABULA_JAR}" ]; then
  TABULA_JAR=$(find "${HERE}/usr/share/tabula" -type f -name "*.jar" 2>/dev/null | head -n 1 || true)
fi

if [ -z "${TABULA_JAR}" ] || [ ! -f "${TABULA_JAR}" ]; then
  echo "[Tabula] Fatal Error: tabula.jar not found inside AppImage." >&2
  exit 1
fi

# ------------------------------------------------------------------------------
# 3. Explicit Multi-Tier Port Verification & Selection
# ------------------------------------------------------------------------------
# Returns 0 if port is free to bind, 1 if port is in use
is_port_available() {
  local port="$1"

  # Tier 1: Python 3 socket bind test
  if command -v python3 >/dev/null 2>&1; then
    python3 -c "import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
try:
    s.bind(('127.0.0.1', int(${port})))
    s.close()
    sys.exit(0)
except Exception:
    sys.exit(1)" 2>/dev/null
    return $?
  fi

  # Tier 2: Perl socket bind test
  if command -v perl >/dev/null 2>&1; then
    perl -e '
      use Socket;
      socket(S, PF_INET, SOCK_STREAM, getprotobyname("tcp")) or exit 1;
      setsockopt(S, SOL_SOCKET, SO_REUSEADDR, 1);
      bind(S, sockaddr_in('$port', inet_aton("127.0.0.1"))) or exit 1;
      close(S);
      exit 0;
    ' 2>/dev/null
    return $?
  fi

  # Tier 3: Kernel /proc/net/tcp inspection
  if [ -r /proc/net/tcp ]; then
    local hex_port
    hex_port=$(printf "%04X" "${port}")
    if grep -q -E ":${hex_port} " /proc/net/tcp 2>/dev/null; then
      return 1
    fi
    if [ -r /proc/net/tcp6 ] && grep -q -E ":${hex_port} " /proc/net/tcp6 2>/dev/null; then
      return 1
    fi
    return 0
  fi

  # Tier 4: ss fallback
  if command -v ss >/dev/null 2>&1; then
    if ss -tlpn 2>/dev/null | grep -q ":${port} "; then
      return 1
    fi
    return 0
  fi

  return 0
}

# Determine available port
TARGET_PORT="${TABULA_PORT:-8080}"
MAX_PORT_SEARCH=20
CURRENT_PORT="${TARGET_PORT}"
PORT_FOUND=false

while [ "${MAX_PORT_SEARCH}" -gt 0 ]; do
  if is_port_available "${CURRENT_PORT}"; then
    PORT_FOUND=true
    break
  else
    echo "[Tabula] Notice: Port ${CURRENT_PORT} is in use. Checking next port..."
    CURRENT_PORT=$((CURRENT_PORT + 1))
    MAX_PORT_SEARCH=$((MAX_PORT_SEARCH - 1))
  fi
done

if [ "${PORT_FOUND}" != "true" ]; then
  echo "[Tabula] Error: Could not find an available TCP port after multiple attempts." >&2
  exit 1
fi

echo "[Tabula] Launching Tabula server on http://127.0.0.1:${CURRENT_PORT}/"

# ------------------------------------------------------------------------------
# 4. Library Path and Environment Setup
# ------------------------------------------------------------------------------
# Writable, exec-capable temp dir and a stable working directory
TABULA_HOME_DIR="${TABULA_DATA_PATH:-${XDG_DATA_HOME:-$HOME/.local/share}/tabula}"
mkdir -p "${TABULA_HOME_DIR}/tmp"
cd "${TABULA_HOME_DIR}" || cd "$HOME" || exit 1

# Prepend AppDir/usr/bin so our sanitizing xdg-open wrapper handles browser calls
export PATH="${HERE}/usr/bin:${PATH}"

# Point LD_LIBRARY_PATH to bundled libraries
export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/usr/lib/jvm/lib/amd64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# Configure JVM and JNR-FFI native lookup paths directly
JVM_OPTS=(
  "-Dfile.encoding=utf-8"
  "-Xms256M"
  "-Xmx1024M"
  "-Dwarbler.port=${CURRENT_PORT}"
  "-Djava.io.tmpdir=${TABULA_HOME_DIR}/tmp"
  "-Djava.library.path=${HERE}/usr/lib:${HERE}/usr/lib/jvm/lib/amd64"
  "-Djnr.ffi.library.path=${HERE}/usr/lib"
  #"-Djruby.native.verbose=true" # comment out to reduce log noise
)

# Parse runtime arguments
OPEN_BROWSER="true"
USER_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --no-browser|-n)
      OPEN_BROWSER="false"
      ;;
    *)
      USER_ARGS+=("$arg")
      ;;
  esac
done

if [ "${OPEN_BROWSER}" = "true" ]; then
  JVM_OPTS+=("-Dtabula.openBrowser=true")
else
  JVM_OPTS+=("-Dtabula.openBrowser=false")
fi

# Execute Tabula directly via exec to maintain clean signal propagation
exec "${JAVA_BIN}" "${JVM_OPTS[@]}" ${TABULA_JAVA_OPTS:-} -jar "${TABULA_JAR}" "${USER_ARGS[@]}"
